# Server
NODE_ENV=production
PORT=5000
API_JSON_LIMIT=5mb

# CORS (comma-separated origins)
CORS_ORIGIN=https://your-frontend.example.com

# Retrieval controls
DEFAULT_LIMIT=10
MAX_LIMIT=50
QUERY_MAX_LENGTH=300
LOCAL_PRUNE_TOP_K=8
MAX_DOC_AGE_DAYS=3650
LATENCY_TARGET_MS=500
SCALEDOWN_MIN_CANDIDATES=4

# Hybrid chunk index
MIN_SEARCHABLE_CHUNKS=10000
HYBRID_VECTOR_DIMENSIONS=256
INGEST_CHUNK_STORE_PATH=./ingested_chunks.json
INGEST_DEFAULT_CHUNK_SIZE_WORDS=180
INGEST_DEFAULT_CHUNK_OVERLAP_WORDS=35
INGEST_MAX_ITEMS_PER_REQUEST=50
INGEST_MAX_TEXT_CHARS=3000000

# Request protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Scaledown
SCALEDOWN_API_URL=https://api.scaledown.xyz/compress/raw/
SCALEDOWN_API_KEY=replace_with_real_key
SCALEDOWN_TIMEOUT_MS=8000
