# Server
NODE_ENV=production
PORT=5000
API_JSON_LIMIT=50kb

# CORS (comma-separated origins)
CORS_ORIGIN=https://your-frontend.example.com

# Retrieval controls
DEFAULT_LIMIT=10
MAX_LIMIT=50
QUERY_MAX_LENGTH=300

# Request protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Scaledown
SCALEDOWN_API_URL=https://api.scaledown.xyz/compress/raw/
SCALEDOWN_API_KEY=replace_with_real_key
SCALEDOWN_TIMEOUT_MS=8000
